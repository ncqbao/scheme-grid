#!/bin/bash
# Bundle all payloads before distribution. This installer never changes Gatekeeper.
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
installer_contents=$(cd "$(dirname "$0")/.." && pwd -P)
resources="$installer_contents/Resources"
target_parent="$HOME/Applications"
target="$target_parent/Scheme Grid.app"
stage=""

notify_error() {
  /usr/bin/osascript - "$1" <<'APPLESCRIPT'
on run argv
  display alert "Scheme Grid could not install" message (item 1 of argv) as critical
end run
APPLESCRIPT
}
fail() { notify_error "$1"; exit 1; }
on_error() {
  notify_error "The installation did not finish. Your drawings were not changed. Ask lab IT to review this package. A partial staging folder may remain in your Applications folder."
}
trap on_error ERR

architecture=$(/usr/bin/uname -m)
mac_version=$(/usr/bin/sw_vers -productVersion)
mac_major=${mac_version%%.*}
[ "$mac_major" -ge 13 ] || fail "Scheme Grid needs macOS 13 or newer."
case "$architecture" in
  arm64) payload="$resources/payload/apple-silicon/Scheme Grid.app" ;;
  x86_64) payload="$resources/payload/intel/Scheme Grid.app" ;;
  *) fail "This package supports Apple silicon and Intel Macs." ;;
esac
marker_relative="Contents/Resources/SchemeGridInstallation.plist"
[ -d "$payload" ] || fail "The bundled app is missing. Download the complete installer again."
[ -f "$payload/$marker_relative" ] || fail "The bundled app has no Scheme Grid installation marker."
payload_kind=$(/usr/libexec/PlistBuddy -c 'Print :kind' "$payload/$marker_relative")
[ "$payload_kind" = "schemegrid-desktop" ] || fail "This is not a recognized Scheme Grid app."

# Verify all regular payload files, using hashes prepared when this installer is built.
manifest="$(dirname "$payload")/SHA256SUMS.txt"
[ -f "$manifest" ] || fail "The bundled app checksum list is missing."
(cd "$(dirname "$payload")" && /usr/bin/shasum -a 256 -c SHA256SUMS.txt >/dev/null) || fail "The bundled app failed its file check. Download the complete installer again."

[ ! -L "$target_parent" ] || fail "Your Applications folder is a link. Ask lab IT to choose the installation location."
/bin/mkdir -p "$target_parent"
resolved_parent=$(cd "$target_parent" && pwd -P)
[ "$resolved_parent" = "$target_parent" ] || fail "The Applications folder resolves to another location. Ask lab IT to install this package."
[ ! -L "$target" ] || fail "An application link already uses the name Scheme Grid. Ask lab IT to review it."
if [ -e "$target" ]; then
  [ -d "$target" ] && [ -f "$target/$marker_relative" ] || fail "Another app already uses the name Scheme Grid. Nothing was replaced."
  existing_kind=$(/usr/libexec/PlistBuddy -c 'Print :kind' "$target/$marker_relative")
  [ "$existing_kind" = "schemegrid-desktop" ] || fail "Another app already uses the name Scheme Grid. Nothing was replaced."
fi

stage="$target_parent/.schemegrid-stage-$(/usr/bin/uuidgen).app"
[ ! -e "$stage" ] || fail "A staging folder already exists. Try the installer again."
/usr/bin/ditto "$payload" "$stage"
[ -x "$stage/Contents/MacOS/Electron" ] || fail "The copied app is incomplete. Ask lab IT to review this installer."
if [ -e "$target" ]; then
  backup="$target_parent/Scheme Grid Previous $(/bin/date +%Y%m%d-%H%M%S)-$(/usr/bin/uuidgen).app"
  [ ! -e "$backup" ] || fail "The backup name already exists. Try again."
  /bin/mv "$target" "$backup"
fi
/bin/mv "$stage" "$target"
stage=""
trap - ERR

/usr/bin/osascript - "$target" <<'APPLESCRIPT'
on run argv
  set appPath to item 1 of argv
  set reply to display dialog "Scheme Grid is installed in your Applications folder. Everything it needs is included." with title "You’re ready!" buttons {"Done", "Open Scheme Grid"} default button "Open Scheme Grid"
  if button returned of reply is "Open Scheme Grid" then
    do shell script "/usr/bin/open " & quoted form of appPath
  end if
end run
APPLESCRIPT
